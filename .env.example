# Copy to .env and fill in. Never commit real keys.
# Kane CLI auth (pick one):
#  - OAuth: run `kane-cli login --oauth` once, then leave these unset.
#  - Basic auth: username + access key from the TestMu AI dashboard > Credentials.
LT_USERNAME=
LT_ACCESS_KEY=

# LLM fixer (pick one; the loop tries rules first, then the LLM).
# Gemini via its OpenAI-compatible endpoint:
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# Groq via its OpenAI-compatible endpoint:
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# App server port (default 3000)
PORT=3000
